{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["client/**/*.ts", "worker/src/**/*.ts", "worker/test/**/*.ts", "vitest.config.ts"]
}